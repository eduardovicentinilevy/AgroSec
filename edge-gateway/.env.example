BACKEND_URL=http://localhost:3000

# Credenciais do gateway (obtidas após login com um usuário de campo)
AGROSEC_API_TOKEN=
AGROSEC_NODE_ID=

# Simula a instabilidade de conectividade rural: fração de ciclos (0-1) em
# que o gateway se considera "offline" mesmo com rede física disponível.
SIMULATED_OFFLINE_PROBABILITY=0.4

# Intervalo entre leituras de sensor simuladas, em segundos.
READING_INTERVAL_SECONDS=3

# Intervalo entre tentativas de sincronização, em segundos.
SYNC_INTERVAL_SECONDS=10
