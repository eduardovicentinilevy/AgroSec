BACKEND_URL=http://localhost:3000
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Intervalo (segundos) entre ciclos de polling do "assinante" de eventos.
# Em produção, este polling é substituído por uma assinatura push do
# GCP Pub/Sub acionando uma Cloud Function equivalente a run_correlation_cycle().
POLL_INTERVAL_SECONDS=5
